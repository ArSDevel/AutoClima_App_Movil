<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 o anterior. La app no usa el respaldo automático de Android: su único respaldo es el que se hace desde
     el menú Respaldo, así los datos de los clientes no salen del teléfono sin que el usuario lo decida. -->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
